{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "apps/DocumentProcessing/backend",
    "monorepo": true,
    "root": "apps/DocumentProcessing/backend",
    "compilerOptions": {
        "webpack": true,
        "tsConfigPath": "tsconfig.json"
    },
    "projects": {
        "document-processing-backend": {
            "type": "application",
            "root": "apps/DocumentProcessing/backend",
            "entryFile": "public/index",
            "sourceRoot": "apps/DocumentProcessing/backend",
            "compilerOptions": {
                "tsConfigPath": "tsconfig.json"
            }
        },
        "subscription-backend": {
            "type": "application",
            "root": "apps/Subscription",
            "entryFile": "main",
            "sourceRoot": "apps/Subscription/src",
            "compilerOptions": {
                "tsConfigPath": "tsconfig.json"
            }
        }
    }
}